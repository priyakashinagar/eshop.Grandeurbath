# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/grandeur_bath

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Website addresses allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Razorpay keys (Dashboard > Account & Settings > API Keys). Leave empty to use test mode locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# First admin account, created by `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay webhook secret (Dashboard > Webhooks). Endpoint: <API>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP). Leave SMTP_HOST empty to print emails in the console while developing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Grandeur Bath <no-reply@grandeurbath.com>
# Receives new order and enquiry alerts
ADMIN_NOTIFY_EMAIL=

# Public addresses, used in emails, invoices and uploaded image links
WEBSITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
UPLOAD_DIR=uploads

# How long logs are kept before MongoDB deletes them automatically
API_LOG_DAYS=90
EVENT_LOG_DAYS=365

# Optional: DNS servers for mongodb+srv lookups (only needed if you see "querySrv ECONNREFUSED")
# DNS_SERVERS=8.8.8.8,1.1.1.1
