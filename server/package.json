{
  "name": "grandeur-bath-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for the Grandeur Bath e-commerce website (Express + MongoDB)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "dev:memory": "node --env-file-if-exists=.env scripts/memory.js",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2"
  }
}
